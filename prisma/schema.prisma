datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Campaign {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String?
  isActive    Boolean      @default(true)
  tcVersion   String       @default("1.0.0")
  tcContent   String       // Full Markdown or legal text of Terms & Conditions
  schemaJson  String       // Declarative JSON structure of questions & step flow
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  responses   Response[]
  consents    ConsentLog[]

  @@index([slug])
}

model RespondentProfile {
  id           String     @id @default(cuid())
  profileToken String     @unique // Client-held identifier tying multiple tests to one person
  fullName     String
  email        String
  birthDate    String
  gender       String
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  responses    Response[]

  @@index([email])
  @@index([fullName])
}

model Response {
  id             String             @id @default(cuid())
  campaignId     String
  campaign       Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  profileId      String?
  profile        RespondentProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  answersJson    String             // Serialized validated respondent answers
  answerLogsJson String?            // Full question-by-question log with exact option labels for admin
  respondentRef  String?            // Optional pseudonymous tracking identifier
  completionSec  Int                // Time spent in seconds to complete
  createdAt      DateTime           @default(now())
  consent        ConsentLog?

  @@index([campaignId, createdAt])
  @@index([profileId, createdAt])
}

model ConsentLog {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  responseId String   @unique
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  tcVersion  String   // Exact T&C version agreed to
  tcChecksum String   // SHA-256 hash of T&C text at time of acceptance
  ipHash     String   // Anonymized/hashed IP address for audit verification
  userAgent  String   // Client user agent string
  agreedAt   DateTime @default(now())

  @@index([campaignId, tcChecksum])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
